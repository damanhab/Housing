---
import { existsSync } from "node:fs";
import { join } from "node:path";
import type { Lang } from "../lib/site";
import { IMAGES, type Slot } from "../data/images";
interface Props { slot: Slot; lang: Lang; class?: string; eager?: boolean; ratio?: string }
const { slot, lang, class: cls, eager = false, ratio = "4 / 3" } = Astro.props;
const img = IMAGES[slot];
const has = existsSync(join(process.cwd(), "public", "images", img.file));
// A lighter WebP twin (same name) is served where it exists; the JPEG stays as the fallback.
const webp = img.file.replace(/\.jpe?g$/i, ".webp");
const hasWebp = webp !== img.file && existsSync(join(process.cwd(), "public", "images", webp));
---
<figure class:list={["photo", cls]} style={`aspect-ratio: ${ratio}`}>
  {has
    ? <picture>
        {hasWebp && <source type="image/webp" srcset={`/images/${webp}`} />}
        <img src={`/images/${img.file}`} alt={img.alt[lang]} style={img.pos ? `object-position: ${img.pos}` : undefined} loading={eager ? "eager" : "lazy"} decoding="async" fetchpriority={eager ? "high" : undefined} />
      </picture>
    : <div class="ph" role="img" aria-label={img.alt[lang]}>
        <svg viewBox="0 0 100 100" aria-hidden="true"><rect width="100" height="27.33" fill="currentColor"/><rect y="36.33" width="100" height="27.33" fill="currentColor"/><rect y="72.67" width="39" height="27.33" fill="currentColor"/><rect x="61" y="72.67" width="39" height="27.33" fill="currentColor"/></svg>
      </div>}
</figure>
<style>
  .photo { margin: 0; border-radius: var(--radius-lg); overflow: hidden; background: var(--sand-2); max-width: 100%; }
  .photo picture { display: block; width: 100%; height: 100%; }
  .photo img { width: 100%; height: 100%; object-fit: cover; }
  .ph { width: 100%; height: 100%; display: grid; place-items: center; color: var(--line-strong); background: linear-gradient(160deg, var(--sand-2), var(--sand)); }
  .ph svg { width: 14%; min-width: 40px; max-width: 72px; }
</style>

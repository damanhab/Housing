---
import Base from "../layouts/Base.astro";
import RequestPanel from "../components/RequestPanel.astro";
import Icon from "../components/Icon.astro";
import type { Lang } from "../lib/site";
import { SITE_URL, CONTACT } from "../lib/site";
import { href, absUrl } from "../lib/routes";
import { CITIES, RULES, RULES_SOURCE, FAQ, UI, trackOf } from "../data/content";
interface Props { lang: Lang }
const { lang } = Astro.props;
const L = (ar: string, en: string) => (lang === "ar" ? ar : en);
const faqs = FAQ.filter((f) => f.home);

const steps = [
  { t: L("أرسل الطلب", "Send the request"), d: L("المدينة، عدد العمال، تاريخ البدء.", "City, headcount, start date.") },
  { t: L("نرتّب السكن", "We arrange it"), d: L("مبنى مرخّص بطاقة تكفي عمالتك، ومعه النقل والتموين عند الحاجة.", "A licensed building sized for your crew, with transport and catering if you need them.") },
  { t: L("يسكن عمّالك", "Your crew moves in"), d: L("نجهّز شهادة إثبات السكن، ونتابع التشغيل يومياً.", "We prepare the housing proof certificate and run operations daily.") },
];
const services = [
  { key: "svc-housing" as const, icon: "bed" as const, t: L("السكن", "Housing"), d: L("غرف مجهّزة في مبانٍ مرخّصة، ومشرف سعودي، ونظافة دورية.", "Furnished rooms in licensed buildings, a Saudi supervisor, periodic cleaning.") },
  { key: "svc-transport" as const, icon: "bus" as const, t: L("النقل", "Transport"), d: L("رحلات يومية بين السكن والموقع على ورديات شركتك.", "Daily trips between housing and site on your shifts.") },
  { key: "svc-catering" as const, icon: "meal" as const, t: L("التموين", "Catering"), d: L("وجبات يومية تناسب جنسيات عمالتك.", "Daily meals suited to your workforce.") },
  { key: "svc-management" as const, icon: "keys" as const, t: L("إدارة السكن", "Management"), d: L("صيانة وأمن وتجديد الرخصة والشهادات.", "Maintenance, security, licence and certificate renewals.") },
];

const jsonld = [
  { "@context": "https://schema.org", "@type": "WebSite", "@id": `${SITE_URL}/#site`, url: absUrl("home", lang, SITE_URL), name: L("سكن هب", "SakanHub"), inLanguage: lang, publisher: { "@id": `${SITE_URL}/#org` } },
  {
    "@context": "https://schema.org", "@type": "Service",
    serviceType: L("سكن العمال", "Worker accommodation"),
    provider: { "@id": `${SITE_URL}/#org` },
    areaServed: CITIES.map((c) => ({ "@type": "City", name: c.name[lang] })),
    availableChannel: { "@type": "ServiceChannel", serviceUrl: absUrl("request", lang, SITE_URL) },
  },
  {
    "@context": "https://schema.org", "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q[lang], acceptedAnswer: { "@type": "Answer", text: f.a[lang] } })),
  },
];
---
<Base lang={lang} pageKey="home" jsonld={jsonld}>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <h1>{L("سكن عمّالك… بطلب واحد", "Your workforce housed. One request.")}</h1>
        <p class="lede">{L("حدّد المدينة وعدد العمال، ونرتّب السكن المرخّص والنقل والتموين.", "Tell us the city and headcount. We arrange licensed housing, transport and catering.")}</p>
      </div>
      <RequestPanel lang={lang} id="hero-request" />
      <div class="hero-rules">
        <p class="hr-title">{L("القواعد التي نطبّقها على طلبك", "The rules we apply to your request")}</p>
        <dl>
          <div><dt class="num">4 m²</dt><dd>{L("لكل فرد في غرفة النوم", "per person, bedroom")}</dd></div>
          <div><dt class="num">10</dt><dd>{L("حد أعلى للغرفة", "max per room")}</dd></div>
          <div><dt class="num">1 / 8</dt><dd>{L("دورة مياه لكل 8 أفراد", "sanitary set per 8")}</dd></div>
        </dl>
        <p class="hr-src">{RULES_SOURCE[lang]} <a href={href("regulations", lang)}>{L("الدليل الكامل", "Full guide")}</a></p>
      </div>
    </div>
  </section>

  <section class="section steps-section" aria-labelledby="how">
    <div class="container">
      <div class="section-head"><h2 id="how">{L("ثلاث خطوات من الطلب إلى السكن", "From request to move-in")}</h2></div>
      <ol class="steps">
        {steps.map((s, i) => (
          <li><span class="step-n num" aria-hidden="true">{i + 1}</span><h3>{s.t}</h3><p>{s.d}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section--sand" aria-labelledby="svc">
    <div class="container split">
      <div class="section-head sticky">
        <h2 id="svc">{L("كل ما حول السرير", "Everything around the bed")}</h2>
        <p>{L("اطلب السكن وحده، أو معه ما تحتاجه.", "Book housing alone, or with what you need.")}</p>
      </div>
      <ul class="svc-list">
        {services.map((s) => (
          <li>
            <a href={href(s.key, lang)}>
              <Icon name={s.icon} class="svc-ic" />
              <span class="svc-t">{s.t}</span>
              <span class="svc-d">{s.d}</span>
              <Icon name="arrow" class="svc-go flip" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--ink" aria-labelledby="rules">
    <div class="container split">
      <div class="section-head">
        <h2 id="rules">{L("السكن غير المرخّص يوقف قوى", "Unlicensed housing stops Qiwa")}</h2>
        <p>{L("لا تأشيرات ولا نقل عمالة، وقد يُعلَّق السجل. نتولى الامتثال عنك.", "No visas, no transfers, and your CR at risk. We handle compliance.")}</p>
        <div class="rules-cta">
          <a class="btn btn--light" href={href("calculator", lang)}>{L("احسب الطاقة الاستيعابية", "Calculate capacity")}</a>
          <a class="link-arrow light" href={href("regulations", lang)}>{L("دليل الاشتراطات", "Regulations guide")}<Icon name="arrow" class="flip" /></a>
        </div>
      </div>
      <dl class="rules">
        {RULES.map((r) => (<div><dt>{r.label[lang]}</dt><dd>{r.value[lang]}</dd></div>))}
        <p class="rules-src">{RULES_SOURCE[lang]}</p>
      </dl>
    </div>
  </section>

  <section class="section" id="cities" aria-labelledby="cities-h">
    <div class="container">
      <div class="section-head">
        <h2 id="cities-h">{L("خمس مدن، ومسار الترخيص الصحيح لكل منها", "Five cities. The right licensing track in each.")}</h2>
      </div>
      <ul class="cities">
        {CITIES.map((c) => (
          <li>
            <a href={href(c.key, lang)}>
              <span class="c-name">{c.name[lang]}</span>
              <span class="c-areas">{c.areas.slice(0, 3).map((a) => a.name[lang]).join(L("، ", " · "))}</span>
              <span class={`c-track t-${c.track}`}>{trackOf(c, lang)}</span>
              <Icon name="arrow" class="c-go flip" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--sand" aria-labelledby="owners-h">
    <div class="container owners">
      <div>
        <h2 id="owners-h">{L("تملك عمارة أو مجمعاً؟", "Own a building or compound?")}</h2>
        <ul class="ticks">
          <li><Icon name="check" />{L("نقيّم طاقتها المرخّصة", "We assess its licensable capacity")}</li>
          <li><Icon name="check" />{L("نجهّزها للترخيص", "We prepare it for licensing")}</li>
          <li><Icon name="check" />{L("نشغّلها لشركات تحتاج سكناً", "We operate it for companies that need housing")}</li>
        </ul>
      </div>
      <a class="btn btn--ink" href={href("owners", lang)}>{L("سجّل عقارك", "List your building")}<Icon name="arrow" class="flip" /></a>
    </div>
  </section>

  <section class="section" aria-labelledby="faq-h">
    <div class="container split">
      <div class="section-head">
        <h2 id="faq-h">{L("أسئلة شائعة", "Questions, answered")}</h2>
        <a class="link-arrow" href={href("faq", lang)}>{L("كل الأسئلة", "All questions")}<Icon name="arrow" class="flip" /></a>
      </div>
      <div class="faq">
        {faqs.map((f, i) => (
          <details open={i === 0}>
            <summary><h3>{f.q[lang]}</h3><Icon name="chevron" class="chev" /></summary>
            <p>{f.a[lang]}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="closing" aria-labelledby="close-h">
    <div class="container closing-inner">
      <div>
        <h2 id="close-h">{L("عمّالك يحتاجون سكناً؟ ابدأ بطلب واحد.", "Need housing for your crew? Start with one request.")}</h2>
        <p class="closing-sub">{L("شريك السكن لشركات رائدة.", "The housing partner for industry leaders.")}</p>
      </div>
      <div class="closing-cta">
        <a class="btn" href={href("request", lang)}>{UI.nav.request[lang]}<Icon name="arrow" class="flip" /></a>
        <a class="btn btn--ghost" href={`https://wa.me/${CONTACT.whatsapp}`} rel="noopener" target="_blank"><Icon name="chat" />{UI.nav.whatsapp[lang]}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { background: var(--sand); padding-block: var(--s8); border-block-end: 1px solid var(--line); }
  .hero + .steps-section { padding-block-start: var(--s8); }
  .hero-grid { display: grid; grid-template-columns: 1fr minmax(0, 520px); grid-template-rows: auto 1fr; column-gap: var(--s8); row-gap: var(--s6); align-items: start; }
  .hero-grid > :global(form) { grid-column: 2; grid-row: 1 / span 2; }
  .hero-rules { grid-column: 1; grid-row: 2; align-self: end; max-width: 30rem; }
  .hr-title { font-weight: 800; font-size: 0.92rem; margin-block-end: var(--s3); }
  .hero-rules dl { margin: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--s4); border-block-start: 1px solid var(--line-strong); padding-block-start: var(--s4); }
  .hero-rules dl div { display: grid; gap: 2px; align-content: start; }
  .hero-rules dt { font-weight: 800; font-size: var(--step-2); line-height: 1.1; color: var(--ink); }
  html[lang="ar"] .hero-rules dt { direction: ltr; text-align: right; }
  .hero-rules dd { margin: 0; font-size: 0.86rem; color: var(--ink-2); line-height: 1.35; }
  .hr-src { font-size: 0.8rem; color: var(--ink-2); margin-block-start: var(--s3); }
  .hero-copy { padding-block-start: var(--s7); display: grid; gap: var(--s5); align-content: start; }
  .hero h1 { font-size: clamp(2.6rem, 1.6rem + 3.6vw, 4.4rem); max-width: 12ch; }
  html[lang="en"] .hero h1 { max-width: 13ch; }
  .lede { font-size: var(--step-2); color: var(--ink-2); max-width: 26ch; line-height: 1.4; }
  .ticks :global(svg) { width: 20px; height: 20px; color: var(--ok); flex: none; }

  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--s6); counter-reset: s; position: relative; }
  .steps::before { content: ""; position: absolute; inset-inline: 22px calc(33% - 22px); top: 22px; height: 1px; background: var(--line-strong); }
  .steps li { position: relative; display: grid; gap: var(--s3); align-content: start; }
  .step-n { width: 44px; height: 44px; border-radius: 50%; display: grid; place-items: center; background: var(--white); border: 1px solid var(--line-strong); font-weight: 800; position: relative; }
  .steps li:first-child .step-n { background: var(--ink); color: var(--white); border-color: var(--ink); }
  .steps p { color: var(--ink-2); max-width: 30ch; }

  .split { display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); gap: var(--s8); align-items: start; }
  .sticky { position: sticky; top: 100px; }
  .svc-list { list-style: none; margin: 0; padding: 0; border-block-start: 1px solid var(--line-strong); }
  .svc-list a { display: grid; grid-template-columns: 28px 9rem 1fr 20px; gap: var(--s4); align-items: center; padding-block: var(--s5); border-block-end: 1px solid var(--line-strong); text-decoration: none; transition: background-color 150ms var(--ease-out); padding-inline: var(--s3); }
  .svc-list a:hover { background: rgb(255 255 255 / 0.7); }
  :global(.svc-ic) { color: var(--ink) !important; width: 26px; height: 26px; color: var(--clay); }
  .svc-t { font-weight: 800; font-size: var(--step-1); }
  .svc-d { color: var(--ink-2); }
  :global(.svc-go) { width: 18px; height: 18px; color: var(--ink-3); }
  .svc-list a:hover :global(.svc-go) { color: var(--ink); }

  .rules-cta { display: flex; flex-wrap: wrap; gap: var(--s4); align-items: center; padding-block-start: var(--s3); }
  .link-arrow.light { color: var(--white); }
  .rules { margin: 0; display: grid; border-block-start: 1px solid #39425A; }
  .rules div { display: grid; grid-template-columns: minmax(9rem, 0.8fr) 1.2fr; gap: var(--s4); padding-block: var(--s4); border-block-end: 1px solid #39425A; }
  .rules dt { color: #B9C0CE; }
  .rules dd { margin: 0; color: var(--white); font-weight: 800; }
  .rules-src { font-size: 0.8rem; color: #9AA3B5; padding-block-start: var(--s3); }

  .cities { list-style: none; margin: 0; padding: 0; border-block-start: 1px solid var(--line); }
  .cities a { display: grid; grid-template-columns: 12rem 1fr auto 20px; gap: var(--s5); align-items: center; padding: var(--s5) var(--s3); border-block-end: 1px solid var(--line); text-decoration: none; border-radius: 0; transition: background-color 150ms; }
  .cities a:hover { background: var(--sand); }
  .c-name { font-weight: 800; font-size: var(--step-2); }
  .c-areas { color: var(--ink-2); }
  .c-track { font-weight: 800; font-size: 0.85rem; padding: 6px 12px; border-radius: 999px; background: var(--sand-2); color: var(--ink); white-space: nowrap; }
  .c-track.t-rcjy { background: var(--ink); color: var(--white); }
  :global(.c-go) { width: 18px; height: 18px; color: var(--ink-3); }

  .owners { display: flex; justify-content: space-between; align-items: center; gap: var(--s6); flex-wrap: wrap; }
  .ticks { list-style: none; margin: var(--s4) 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--s3) var(--s6); }
  .ticks li { display: flex; gap: var(--s2); align-items: center; font-weight: 700; }

  .faq { border-block-start: 1px solid var(--line); }
  .faq details { border-block-end: 1px solid var(--line); }
  .faq summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: var(--s4); padding-block: var(--s5); }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary h3 { font-size: var(--step-1); }
  :global(.chev) { width: 20px; height: 20px; flex: none; transition: transform 200ms var(--ease-out); }
  .faq details[open] :global(.chev) { transform: rotate(180deg); }
  .faq details p { color: var(--ink-2); padding-block-end: var(--s5); max-width: 60ch; }

  .closing { background: var(--sand); padding-block: var(--s9); border-block-start: 1px solid var(--line); }
  .closing h2 { max-width: 22ch; }
  .closing-sub { color: var(--ink-2); margin-block-start: var(--s3); font-weight: 700; }
  .closing-inner { display: flex; justify-content: space-between; align-items: center; gap: var(--s6); flex-wrap: wrap; }
  .closing-cta { display: flex; gap: var(--s3); flex-wrap: wrap; }

  @media (max-width: 1000px) {
    .hero-grid, .split { grid-template-columns: 1fr; gap: var(--s6); }
    .hero-copy { padding-block-start: 0; gap: var(--s3); }
    .hero-grid > :global(form) { grid-column: auto; grid-row: auto; }
    .hero-rules { display: none; }
    .hero-grid { grid-template-rows: none; }
    .sticky { position: static; }
    .hero { padding-block: var(--s4) var(--s7); }
    .hero-grid { row-gap: var(--s5); }
    .hero h1 { font-size: clamp(2.1rem, 1.6rem + 3vw, 3rem); }
    .lede { font-size: var(--step-1); }
  }
  @media (max-width: 760px) {
    .steps { grid-template-columns: 1fr; gap: var(--s5); }
    .steps::before { inset-inline: 21.5px auto; width: 1px; height: auto; top: 22px; bottom: 22px; }
    .steps li { grid-template-columns: 44px 1fr; column-gap: var(--s4); row-gap: var(--s1); }
    .step-n { grid-row: 1 / span 2; }
    .svc-list a { grid-template-columns: 28px 1fr 20px; }
    .svc-d { grid-column: 2 / 3; }
    :global(.svc-go) { grid-row: 1; grid-column: 3; }
    .cities a { grid-template-columns: 1fr auto; }
    .c-areas { grid-column: 1 / -1; grid-row: 2; }
    :global(.c-go) { display: none; }
    .rules div { grid-template-columns: 1fr; gap: var(--s1); }
    .section { padding-block: var(--s8); }
  }
</style>

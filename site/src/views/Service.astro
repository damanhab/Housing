---
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import RequestSection from "../components/RequestSection.astro";
import Photo from "../components/Photo.astro";
import type { Lang } from "../lib/site";
import { SITE_URL } from "../lib/site";
import { href, absUrl, type PageKey } from "../lib/routes";
import type { Slot } from "../data/images";
interface Props { lang: Lang; pageKey: PageKey }
const { lang, pageKey } = Astro.props;
type T = { ar: string; en: string };
const S: Record<string, { title: T; lede: T; points: T[]; rule?: T }> = {
  "svc-housing": {
    title: { ar: "سكن مرتّب ومرخّص لطاقمك", en: "Licensed housing your crew will be glad to come back to" },
    lede: { ar: "غرف جاهزة في مبانٍ مرخّصة للسكن الجماعي، على قدّ عدد طاقمك.", en: "Ready rooms in licensed buildings, sized for your crew." },
    points: [
      { ar: "سرير ومفرش وخزانة بقفل لكل شخص", en: "A bed, bedding and a lockable wardrobe for everyone" },
      { ar: "ما يزيد عدد الغرفة عن 10، و4 م² لكل شخص", en: "No more than 10 to a room, 4 m² each" },
      { ar: "دورة مياه لكل 8 أشخاص", en: "One bathroom set for every 8 people" },
      { ar: "تكييف، ومياه شرب نظيفة، وكاميرات أمن", en: "Air conditioning, clean drinking water and security cameras" },
      { ar: "مشرف سعودي متفرّغ، ونظافة دورية", en: "A full-time Saudi supervisor and periodic cleaning" },
      { ar: "شهادة إثبات سكن لمنشأتك", en: "A housing proof certificate for your company" },
    ],
    rule: { ar: "المساحات والأعداد من «الشروط الصحية والفنية والسلامة اللازم توافرها في المساكن الجماعية للأفراد» (وزارة البلديات والإسكان).", en: "Figures from MOMAH's Health, Technical and Safety Conditions Required in Group Housing for Individuals." },
  },
  "svc-transport": {
    title: { ar: "من السكن للموقع، وبالعكس", en: "From housing to site and back" },
    lede: { ar: "باصات على مواعيد ورديّاتك، ترتّبها مع طلب السكن نفسه.", en: "Buses on your shift times, arranged with the housing." },
    points: [
      { ar: "جدول رحلات حسب ورديّاتك", en: "Trips planned around your shifts" },
      { ar: "مواقف للباصات داخل السكن", en: "Bus parking at the housing" },
      { ar: "طلب واحد للسكن والنقل", en: "One request for housing and transport" },
    ],
  },
  "svc-catering": {
    title: { ar: "إعاشة تناسب طاقمك", en: "Meals your crew looks forward to" },
    lede: { ar: "وجبات على ذوق عمّالك وجنسياتهم، من مطبخ مركزي أو مقدّم إعاشة.", en: "Food planned around your crew's tastes, from a central kitchen or caterer." },
    points: [
      { ar: "فطور وغداء وعشاء حسب احتياجك", en: "Breakfast, lunch and dinner, as you need them" },
      { ar: "قوائم طعام تناسب جنسيات العمّال", en: "Menus that suit your crew's nationalities" },
      { ar: "صالة طعام بمساحة 0.7 م² لكل شخص", en: "A dining room with 0.7 m² per person" },
    ],
    rule: { ar: "توفير مطبخ مركزي أو خدمة إعاشة من اشتراطات السكن الجماعي.", en: "A central kitchen or catering service is a group-housing requirement." },
  },
  "svc-management": {
    title: { ar: "نشغّل السكن عنك", en: "We run the housing for you" },
    lede: { ar: "تشغيل يومي، ورخصة وشهادات سارية دائماً.", en: "Day-to-day running, with the licence and certificates always current." },
    points: [
      { ar: "إشراف وأمن على مدار الساعة", en: "Supervision and security around the clock" },
      { ar: "صيانة ونظافة دورية", en: "Maintenance and periodic cleaning" },
      { ar: "تجديد الرخصة كل سنة", en: "Yearly licence renewal" },
      { ar: "الطاقة مطابقة دائماً لعدد عمّالك في قوى", en: "Capacity kept in line with your Qiwa headcount" },
    ],
  },
};
const names: Record<string, T> = {
  "svc-housing": { ar: "السكن", en: "Housing" },
  "svc-transport": { ar: "النقل", en: "Transport" },
  "svc-catering": { ar: "الإعاشة", en: "Meals" },
  "svc-management": { ar: "إدارة السكن", en: "Management" },
};
const d = S[pageKey];
const crumbs = [{ key: pageKey, name: names[pageKey][lang] }];
const jsonld = [{ "@context": "https://schema.org", "@type": "Service", name: d.title[lang], provider: { "@id": `${SITE_URL}/#org` }, areaServed: { "@type": "Country", name: lang === "ar" ? "السعودية" : "Saudi Arabia" }, url: absUrl(pageKey, lang, SITE_URL) }];
---
<Base lang={lang} pageKey={pageKey} jsonld={jsonld} crumbs={crumbs}>
  <PageHead lang={lang} crumbs={crumbs} title={d.title[lang]} lede={d.lede[lang]} />
  <div class="container body-grid">
    <div class="doc">
      <section>
        <h2>{lang === "ar" ? "وش تشمل الخدمة" : "What you get"}</h2>
        <ul class="list-check">{d.points.map((p) => <li>{p[lang]}</li>)}</ul>
        {d.rule && <p class="source">{d.rule[lang]}</p>}
      </section>
      <section>
        <h2>{lang === "ar" ? "خدمات أخرى" : "Other services"}</h2>
        <ul class="list-check">
          {Object.keys(S).filter((k) => k !== pageKey).map((k) => <li><a href={href(k as PageKey, lang)}>{names[k][lang]}</a></li>)}
        </ul>
      </section>
    </div>
    <aside><Photo slot={pageKey as Slot} lang={lang} ratio="4 / 5" /></aside>
  </div>
  <RequestSection lang={lang} id="svc-request" />
</Base>

---
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import RequestSection from "../components/RequestSection.astro";
import type { Lang } from "../lib/site";
import { SITE_URL } from "../lib/site";
import { href, absUrl } from "../lib/routes";
import { RULES, TRACK_LABEL, CITIES, TBD } from "../data/content";
interface Props { lang: Lang }
const { lang } = Astro.props;
const L = (ar: string, en: string) => (lang === "ar" ? ar : en);
const crumbs = [{ key: "regulations" as const, name: L("دليل الاشتراطات", "Regulations guide") }];
const updated = "2026-10-06";
// Official sources. MOMAH links checked 7 Oct 2026; re-check quarterly (HANDOVER.md).
const SRC = {
  conditions: "https://momah.gov.sa/sites/default/files/2024-04/dlyl-alshrwt-alshyt-walfnyt-walslamt-allazm-twafrha-fy-almsakn-aljmayt-llafrad-.pdf",
  program: lang === "ar" ? "https://momah.gov.sa/ar/node/16267" : "https://momah.gov.sa/en/node/16267",
  certificate: "https://momah.gov.sa/ar/e-services/asdar-shhadt-athbat-skn-jmay",
  // Not reachable from outside Saudi Arabia when checked; the founder is testing these from inside the Kingdom.
  balady: "https://balady.gov.sa/ar/services/" + encodeURIComponent("إصدار-رخصة-سكن-جماعي-للأفراد"),
  modon: "https://modon.gov.sa/ar/Eservices/UsageGuides/",
};
const jsonld = [{
  "@context": "https://schema.org", "@type": "Article",
  headline: L("دليل اشتراطات السكن الجماعي للأفراد في السعودية", "Saudi group-housing (worker housing) regulations guide"),
  inLanguage: lang, dateModified: updated, datePublished: updated,
  author: { "@id": `${SITE_URL}/#org` }, publisher: { "@id": `${SITE_URL}/#org` },
  mainEntityOfPage: absUrl("regulations", lang, SITE_URL),
}];
---
<Base lang={lang} pageKey="regulations" jsonld={jsonld} crumbs={crumbs}>
  <PageHead lang={lang} crumbs={crumbs}
    title={L("اشتراطات السكن الجماعي للأفراد", "Saudi worker housing regulations")}
    lede={L("كل منشأة عندها 20 عاملاً أو أكثر تحتاج سكناً مرخّصاً يكفي عدد عمّالها في قوى. هنا أهم القواعد باختصار.", "Every establishment with 20+ workers needs licensed housing that covers its Qiwa headcount. Here are the main rules, briefly.")}>
    <p class="src-note">
      {L("مصدر المعلومات:", "Source:")} <a href={SRC.conditions} rel="noopener" target="_blank">{L("«الشروط الصحية والفنية والسلامة اللازم توافرها في المساكن الجماعية للأفراد»", "MOMAH Health, Technical and Safety Conditions Required in Group Housing for Individuals")}</a>{L(" الصادرة عن وزارة البلديات والإسكان، وخدمات منصة بلدي. آخر مراجعة:", ", and the Balady platform. Last reviewed:")} <time datetime={updated} class="num">{updated}</time>
    </p>
  </PageHead>
  <div class="container body-grid body-grid--solo">
    <article class="doc">
      <section>
        <h2>{L("مَن يلزمه الترخيص", "Who must comply")}</h2>
        <ul class="list-check">
          <li>{L("كل منشأة عندها 20 عاملاً أو أكثر، بكل فروعها.", "Every establishment with 20+ workers, across all its branches.")}</li>
          <li>{L("السكن المرخّص لازم يكفي عدد العمّال المسجّلين في قوى.", "Licensed housing has to cover the workforce registered on Qiwa.")}</li>
          <li>{L("بدل السكن لا يُعفي المنشأة من الترخيص.", "Paying a housing allowance doesn't exempt you.")}</li>
        </ul>
      </section>
      <section>
        <h2>{L("وش يصير بدون ترخيص", "What happens without a licence")}</h2>
        <ul class="list-check">
          <li>{L("الربط بين بلدي وقوى يكشف إن السكن ما يكفي.", "The Balady–Qiwa link flags the gap.")}</li>
          <li>{L("تتوقف خدمات قوى مثل التأشيرات ونقل الخدمات.", "Qiwa services such as visas and worker transfers stop.")}</li>
          <li>{L("وقد يُعلَّق السجل التجاري.", "The commercial registration can be suspended.")}</li>
        </ul>
      </section>
      <section>
        <h2>{L("الأرقام الأساسية", "The key numbers")}</h2>
        <dl class="facts">{RULES.map((r) => (<div><dt>{r.label[lang]}</dt><dd>{r.value[lang]}</dd></div>))}</dl>
        <p class="source">{L("الطاقة تُحسب من المساحات والمرافق، لا من عدد الأسرّة. غرفة نوم مساحتها الصافية 24 م² تستوعب 6 أشخاص، لا 10.", "Capacity comes from areas and facilities, not beds. A 24 m² net bedroom takes 6 people, not 10.")} <a href={href("calculator", lang)}>{L("جرّب الحاسبة", "Try the calculator")}</a></p>
      </section>
      <section>
        <h2>{L("الرخصة وشهادة إثبات السكن", "Licence vs housing proof certificate")}</h2>
        <dl class="facts">
          <div><dt>{L("رخصة السكن الجماعي", "Group-housing licence")}</dt><dd>{L("باسم مالك المبنى أو مستأجره كاملاً، وتثبت أن العقار مرخّص بطاقة محدّدة.", "Held by the owner or whole-building tenant. Proves the property is licensed at a set capacity.")}</dd></div>
          <div><dt>{L("شهادة إثبات السكن", "Housing proof certificate")}</dt><dd>{L("تصدرها المنشأة التي تستأجر وحدات في عقار مرخّص، بموافقة صاحب الرخصة.", "Issued by a company renting units inside a licensed property, with the licence holder's approval.")}</dd></div>
          <div><dt>{L("جزء من مبنى", "Part of a building")}</dt><dd>{L("ما تصدر رخصة لجزء من مبنى.", "A licence can't be issued for part of a building.")}</dd></div>
        </dl>
      </section>
      <section>
        <h2>{L("جهة الترخيص حسب المدينة", "Licensing track by city")}</h2>
        <dl class="facts">{CITIES.map((c) => c.active
          ? (<div><dt><a href={href(c.key, lang)}>{c.name[lang]}</a></dt><dd>{TRACK_LABEL[c.track][lang]}: {c.trackNote[lang]}</dd></div>)
          : (<div class="off"><dt>{c.name[lang]}</dt><dd><span class="tbd">{TBD[lang]}</span></dd></div>))}</dl>
      </section>
      <section>
        <h2>{L("خطوات الترخيص في بلدي", "Licensing steps on Balady")}</h2>
        <ol class="ordered">
          <li>{L("سجّل الدخول عبر النفاذ الوطني، واختر خدمة رخصة السكن الجماعي.", "Sign in with National SSO and choose the group-housing licence service.")}</li>
          <li>{L("أدخل بيانات الموقع والعقار، والصك أو عقد الإيجار، والطاقة الاستيعابية.", "Enter the location, property, deed or lease, and capacity.")}</li>
          <li>{L("ارفع المستندات: السجل التجاري، والصك أو العقد، والصور، وشهادة إتمام البناء، وموافقة الدفاع المدني.", "Upload your CR, deed or lease, photos, completion certificate and Civil Defense approval.")}</li>
          <li>{L("تتحقّق البلدية من اشتراطات الموقع، ثم تعطيك موافقة مبدئية.", "The municipality checks the location rules and gives initial approval.")}</li>
          <li>{L("عندك 90 يوماً لاستكمال المتطلبات، ثم الكشف الفني وسداد الرسوم.", "You get 90 days to finish the requirements, then inspection and fees.")}</li>
        </ol>
      </section>
      <section>
        <h2>{L("المصادر", "Sources")}</h2>
        <ul class="list-check source">
          <li><a href={SRC.conditions} rel="noopener" target="_blank">{L("وزارة البلديات والإسكان: «الشروط الصحية والفنية والسلامة اللازم توافرها في المساكن الجماعية للأفراد» (PDF)", "MOMAH: Health, Technical and Safety Conditions Required in Group Housing for Individuals (PDF, Arabic)")}</a></li>
          <li><a href={SRC.program} rel="noopener" target="_blank">{L("وزارة البلديات والإسكان: البرنامج الوطني لتطوير السكن الجماعي للأفراد", "MOMAH: National Program for the Development of Group Housing for Individuals")}</a></li>
          <li><a href={SRC.certificate} rel="noopener" target="_blank">{L("وزارة البلديات والإسكان: خدمة إصدار شهادة إثبات سكن جماعي للأفراد", "MOMAH: Group housing proof certificate service (Arabic)")}</a></li>
          <li><a href={SRC.balady} rel="noopener" target="_blank">{L("منصة بلدي: خدمة إصدار رخصة سكن جماعي للأفراد", "Balady: group housing licence service (Arabic)")}</a></li>
          <li><a href={SRC.modon} rel="noopener" target="_blank">{L("«مدن»: أدلة استخدام الخدمات الإلكترونية، ومنها رخصة السكن الجماعي", "MODON: e-service user guides, including the group housing licence (Arabic)")}</a></li>
          <li>{L("الهيئة الملكية للجبيل وينبع", "RCJY (Royal Commission for Jubail and Yanbu)")}</li>
        </ul>
        <p class="source">{L("ملخّص إرشادي، وليس استشارة قانونية. ارجع للنص الرسمي قبل أي قرار.", "A guidance summary, not legal advice. Check the official text before acting.")}</p>
      </section>
    </article>
  </div>
  <RequestSection lang={lang} id="reg-request"
    title={L("خلّ الترخيص علينا", "Leave the licensing to us")}
    lede={L("نوفّر لطاقمك سكناً مرخّصاً ومطابقاً لقوى من أول يوم.", "We house your crew in licensed beds, matched to Qiwa from day one.")} />
</Base>
<style>
  .src-note { font-size: var(--step--1); color: var(--ink-2); margin-block-start: var(--s5); max-width: 62ch; padding-inline-start: var(--s3); border-inline-start: 2px solid var(--line-strong); }
  .facts > div.off dt { color: var(--ink-3); }
</style>

---
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import RequestSection from "../components/RequestSection.astro";
import Photo from "../components/Photo.astro";
import type { Lang } from "../lib/site";
import { SITE_URL } from "../lib/site";
import { href, absUrl } from "../lib/routes";
import { CITIES, TRACK_LABEL, TBD } from "../data/content";
import type { City } from "../data/content";
import type { Slot } from "../data/images";
interface Props { lang: Lang; city: City }
const { lang, city } = Astro.props;
const L = (ar: string, en: string) => (lang === "ar" ? ar : en);
const n = city.name[lang];
const others = CITIES.filter((c) => c.id !== city.id);
const crumbs = [{ key: city.key, name: L(`سكن عمّال ${n}`, `Worker housing in ${n}`) }];
const included = [
  L("غرف مؤثّثة في مبنى مرخّص للسكن الجماعي", "Furnished rooms in a building licensed for group housing"),
  L("طاقة استيعابية محسوبة حسب الاشتراطات", "Capacity worked out to the rules"),
  L("شهادة إثبات سكن لمنشأتك", "A housing proof certificate for your company"),
  L("نقل إلى مواقع العمل، إذا احتجته", "Transport to your sites, if you need it"),
  L("إعاشة، إذا احتجتها", "Meals, if you need them"),
  L("مشرف سعودي ونظافة دورية", "A Saudi supervisor and periodic cleaning"),
];
const jsonld = [{
  "@context": "https://schema.org", "@type": "Service",
  name: L(`سكن عمّال ${n}`, `Worker housing in ${n}`),
  serviceType: L("سكن العمّال", "Worker accommodation"),
  provider: { "@id": `${SITE_URL}/#org` },
  areaServed: { "@type": "City", name: n, containedInPlace: { "@type": "State", name: city.region[lang] } },
  url: absUrl(city.key, lang, SITE_URL),
}];
---
<Base lang={lang} pageKey={city.key} jsonld={jsonld} crumbs={crumbs}>
  <PageHead lang={lang} crumbs={crumbs}
    title={L(`سكن عمّال في ${n}`, `Worker housing in ${n}`)}
    lede={L(`سكن مرخّص لطاقمك في ${n}، قريب من مواقع شغلك، ومعه النقل والإعاشة.`, `Licensed housing for your crew in ${n}, close to your sites, with transport and meals.`)} />
  <div class="container body-grid">
    <div class="doc">
      <section>
        <h2>{L("وين نوفّر السكن", "Where we house crews")}</h2>
        <dl class="facts">
          {city.areas.map((a) => (<div><dt>{a.name[lang]}</dt><dd>{a.note[lang]}</dd></div>))}
        </dl>
      </section>
      <section>
        <h2>{L("وش يشمل السكن", "What's included")}</h2>
        <ul class="list-check">{included.map((i) => <li>{i}</li>)}</ul>
      </section>
      <section>
        <h2>{L(`الترخيص في ${n}`, `Licensing in ${n}`)}</h2>
        <dl class="facts">
          <div><dt>{L("الجهة", "Authority")}</dt><dd>{TRACK_LABEL[city.track][lang]}</dd></div>
          <div><dt>{L("التفاصيل", "Details")}</dt><dd>{city.trackNote[lang]}</dd></div>
          <div><dt>{L("الاشتراطات", "The rules")}</dt><dd>{L("نفسها في كل المدن: مساحة النوم، وعدد الأشخاص في الغرفة، ودورات المياه.", "The same in every city: sleeping area, people per room, sanitary sets.")} <a href={href("regulations", lang)}>{L("دليل الاشتراطات", "Regulations guide")}</a></dd></div>
        </dl>
      </section>
      <section>
        <h2>{L("مدن أخرى", "Other cities")}</h2>
        <ul class="list-check">{others.map((c) => c.active
          ? <li><a href={href(c.key, lang)}>{c.name[lang]}</a></li>
          : <li class="off">{c.name[lang]}<span class="tbd">{TBD[lang]}</span></li>)}</ul>
      </section>
    </div>
    <aside><Photo slot={`city-${city.id}` as Slot} lang={lang} ratio="4 / 5" /></aside>
  </div>
  <RequestSection lang={lang} id="city-request" city={city.id}
    title={L(`تحتاج سكن في ${n}؟`, `Need housing in ${n}?`)} />
</Base>

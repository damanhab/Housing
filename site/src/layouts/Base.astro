---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { IS_PROD, SITE_URL, BRAND, CONTACT, type Lang } from "../lib/site";
import { routeByKey, absUrl, href, type PageKey } from "../lib/routes";

interface Props { lang: Lang; pageKey: PageKey; jsonld?: object[]; crumbs?: { key: PageKey; name: string }[] }
const { lang, pageKey, jsonld = [], crumbs = [] } = Astro.props;
const route = routeByKey(pageKey);
const title = route.title[lang];
const description = route.description[lang];
const canonical = absUrl(pageKey, lang, SITE_URL);
const alt = { ar: absUrl(pageKey, "ar", SITE_URL), en: absUrl(pageKey, "en", SITE_URL) };

const org = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${SITE_URL}/#org`,
  name: BRAND.name,
  alternateName: BRAND.alternateNames,
  url: SITE_URL,
  logo: `${SITE_URL}/icon-512.png`,
  areaServed: { "@type": "Country", name: "Saudi Arabia" },
  ...(CONTACT.isPlaceholder ? {} : { telephone: CONTACT.phone, email: CONTACT.email }),
};
const breadcrumb = crumbs.length ? {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [{ key: "home" as PageKey, name: lang === "ar" ? "الرئيسية" : "Home" }, ...crumbs].map((c, i) => ({
    "@type": "ListItem", position: i + 1, name: c.name, item: absUrl(c.key, lang, SITE_URL),
  })),
} : null;
const graph = [org, ...(breadcrumb ? [breadcrumb] : []), ...jsonld];
---
<!doctype html>
<html lang={lang} dir={lang === "ar" ? "rtl" : "ltr"}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {!IS_PROD && <meta name="robots" content="noindex, nofollow, noarchive" />}
  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang="ar" href={alt.ar} />
  <link rel="alternate" hreflang="en" href={alt.en} />
  <link rel="alternate" hreflang="x-default" href={alt.ar} />
  <link rel="alternate" type="text/markdown" href={href(pageKey, lang).replace(/\/$/, "") + ".md"} />
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta name="theme-color" content="#1D2433" />
  <link rel="preload" href={lang === "ar" ? "/fonts/almarai-extrabold.woff2" : "/fonts/nunito-latin-var.woff2"} as="font" type="font/woff2" crossorigin />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={lang === "ar" ? `${BRAND.nameAr} | ${BRAND.name}` : BRAND.name} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content={lang === "ar" ? "ar_SA" : "en_US"} />
  <meta property="og:image" content={`${SITE_URL}/icon-512.png`} />
  <meta name="twitter:card" content="summary" />
  <script type="application/ld+json" set:html={JSON.stringify(graph.length === 1 ? graph[0] : graph)} />
  <script is:inline>
    // Reveal-on-scroll: only switch it on when the browser supports it and the visitor hasn't asked for reduced motion.
    if ("IntersectionObserver" in window && !matchMedia("(prefers-reduced-motion: reduce)").matches) document.documentElement.classList.add("js-reveal");
  </script>
</head>
<body>
  <a class="skip" href="#main">{lang === "ar" ? "انتقل إلى المحتوى" : "Skip to content"}</a>
  <Header lang={lang} pageKey={pageKey} />
  <main id="main"><slot /></main>
  <Footer lang={lang} />
  <script>
    // Sections below the first one fade up as they scroll into view; list items inside them follow one after another.
    if (document.documentElement.classList.contains("js-reveal")) {
      const targets = document.querySelectorAll<HTMLElement>("main > :not(:first-child), [data-reveal]");
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) if (e.isIntersecting) { e.target.classList.add("is-in"); io.unobserve(e.target); }
      }, { rootMargin: "0px 0px -10% 0px", threshold: 0.08 });
      targets.forEach((t) => {
        t.querySelectorAll<HTMLElement>(":scope .stagger > *").forEach((c, i) => c.style.setProperty("--i", String(i)));
        io.observe(t);
      });
    }
  </script>
</body>
</html>

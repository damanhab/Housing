      "css": ":host{--clay:#C8502A;--clay-hover:#B34522;--clay-wash:#FBEDE7;--ink:#1D2433;--ink-2:#4A5265;--ink-3:#6B7283;--sand:#F6F3EE;--line:#E3DED6;--line-strong:#CFC8BD;font-family:Nunito,Almarai,system-ui,sans-serif} .ds-ro{background:var(--sand);border-radius:12px;padding:16px;color:var(--ink)}.ds-ro p{margin:0 0 12px;font-weight:800;font-size:.92rem}.ds-ro dl{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin:0}.ds-ro dt{font-weight:800;font-size:1.6rem;line-height:1.1;font-variant-numeric:tabular-nums}.ds-ro div:last-child dt{font-size:1rem;padding-top:6px}.ds-ro dd{margin:0;font-size:.86rem;color:var(--ink-2)}"

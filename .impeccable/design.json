      "name": "City Chip",
      "kind": "chip",
      "refersTo": "chip",
      "description": "Single-choice city selector; selected is ink.",
      "html": "<div class=\"ds-chips\"><button class=\"ds-chip\" aria-pressed=\"true\">Jubail</button><button class=\"ds-chip\">Dammam</button></div>",
      "css": ":host{--clay:#C8502A;--clay-hover:#B34522;--clay-wash:#FBEDE7;--ink:#1D2433;--ink-2:#4A5265;--ink-3:#6B7283;--sand:#F6F3EE;--line:#E3DED6;--line-strong:#CFC8BD;font-family:Nunito,Almarai,system-ui,sans-serif} .ds-chips{display:flex;gap:8px}.ds-chip{min-height:40px;padding:0 16px;border-radius:999px;border:1px solid var(--line-strong);background:#fff;color:var(--ink);font:inherit;font-weight:700;cursor:pointer}.ds-chip:hover{border-color:var(--ink-3)}.ds-chip[aria-pressed=true]{background:var(--ink);border-color:var(--ink);color:#fff}.ds-chip:focus-visible{outline:2.5px solid var(--clay);outline-offset:2px}"
    },

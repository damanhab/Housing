      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one clay action per view.",
      "html": "<button class=\"ds-btn\">Request housing</button>",
      "css": ":host{--clay:#C8502A;--clay-hover:#B34522;--clay-wash:#FBEDE7;--ink:#1D2433;--ink-2:#4A5265;--ink-3:#6B7283;--sand:#F6F3EE;--line:#E3DED6;--line-strong:#CFC8BD;font-family:Nunito,Almarai,system-ui,sans-serif} .ds-btn{display:inline-flex;align-items:center;min-height:48px;padding:0 24px;border-radius:10px;border:1px solid transparent;background:var(--clay);color:#fff;font:inherit;font-weight:800;cursor:pointer;box-shadow:0 1px 2px rgb(158 60 29/.25);transition:background-color 160ms cubic-bezier(.16,1,.3,1),transform 160ms}.ds-btn:hover{background:var(--clay-hover)}.ds-btn:active{background:#9E3C1D;transform:translateY(1px)}.ds-btn:focus-visible{outline:2.5px solid var(--clay);outline-offset:3px}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
